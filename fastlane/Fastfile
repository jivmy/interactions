# frozen_string_literal: true

# Remote TestFlight shipping for GitHub-hosted macOS runners (no local Mac).
# Auth is App Store Connect API key only — never commit .p8 / .p12 files.
#
# Required env (GitHub Actions secrets):
#   APP_STORE_CONNECT_API_KEY_ID
#   APP_STORE_CONNECT_ISSUER_ID
#   APP_STORE_CONNECT_API_KEY   (full .p8 PEM contents)
#   DEVELOPMENT_TEAM            (10-character Team ID)
#
# Optional env:
#   BUILD_NUMBER                (defaults to GITHUB_RUN_NUMBER)
#   MARKETING_VERSION           (defaults to 1.0)
#   CHANGELOG                   (TestFlight "What to Test")

require "shellwords"

opt_out_usage
skip_docs
default_platform(:ios)

APP_IDENTIFIER = "com.jimmy.interactions"
XCODEPROJ = "Interactions.xcodeproj"
SCHEME = "Interactions"
REQUIRED_SECRETS = %w[
  APP_STORE_CONNECT_API_KEY_ID
  APP_STORE_CONNECT_ISSUER_ID
  APP_STORE_CONNECT_API_KEY
  DEVELOPMENT_TEAM
].freeze

def missing_secrets
  REQUIRED_SECRETS.select { |name| ENV[name].to_s.strip.empty? }
end

def pem_contents
  content = ENV.fetch("APP_STORE_CONNECT_API_KEY").dup
  content.gsub!("\\n", "\n")
  content.strip!
  content << "\n" unless content.end_with?("\n")
  content
end

def authentication_key_path
  dir = ENV["RUNNER_TEMP"] || Dir.tmpdir
  path = File.join(dir, "AuthKey_#{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}.p8")
  File.write(path, pem_contents)
  File.chmod(0o600, path)
  path
end

def xcode_auth_args
  key_path = authentication_key_path
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{Shellwords.escape(key_path)}",
    "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}",
    "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')}",
    "DEVELOPMENT_TEAM=#{ENV.fetch('DEVELOPMENT_TEAM')}",
    "CODE_SIGN_STYLE=Automatic"
  ].join(" ")
end

def changelog_text(build_number)
  text = ENV["CHANGELOG"].to_s.strip
  return text unless text.empty?

  sha = ENV["GITHUB_SHA"].to_s[0, 7]
  parts = ["CI build #{build_number}"]
  parts << "commit #{sha}" unless sha.empty?
  parts.join(" · ")
end

platform :ios do
  desc "Archive Interactions and upload to TestFlight"
  lane :beta do
    missing = missing_secrets
    unless missing.empty?
      UI.user_error!(
        "Missing required environment variables: #{missing.join(', ')}. " \
        "Add them as GitHub Actions secrets and see docs/TESTFLIGHT.md."
      )
    end

    setup_ci if is_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: pem_contents,
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    auth_args = xcode_auth_args
    build_number = ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    marketing_version = ENV["MARKETING_VERSION"] || "1.0"

    UI.message("Shipping #{APP_IDENTIFIER} #{marketing_version} (#{build_number}) with automatic signing")

    # Keep CODE_SIGN_STYLE=Automatic. Inject team + bundle id for this CI run only.
    # Do NOT set CODE_SIGN_IDENTITY to "Apple Distribution" while automatic signing
    # is on — Xcode archives with Apple Development, then gym re-signs for App Store
    # during export (-allowProvisioningUpdates + ASC API key).
    update_code_signing_settings(
      use_automatic_signing: true,
      path: XCODEPROJ,
      team_id: ENV.fetch("DEVELOPMENT_TEAM"),
      bundle_identifier: APP_IDENTIFIER
    )

    # gym 2.233+ appends both export_xcargs and xcargs to `xcodebuild -exportArchive`.
    # Put ASC API key auth and -allowProvisioningUpdates in xcargs only so they
    # reach archive + export once. Do not also set export_xcargs — that duplicates
    # -authenticationKeyPath / -authenticationKeyID / -authenticationKeyIssuerID /
    # -allowProvisioningUpdates and xcodebuild exits 64.
    # app_store_connect_api_key above is for Spaceship / upload_to_testflight only.
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      destination: "generic/platform=iOS",
      output_directory: "build",
      output_name: "Interactions",
      include_symbols: true,
      export_method: "app-store",
      skip_profile_detection: true,
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: ENV.fetch("DEVELOPMENT_TEAM"),
        uploadSymbols: true,
        compileBitcode: false
      },
      xcargs: [
        auth_args,
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "MARKETING_VERSION=#{marketing_version}"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: changelog_text(build_number)
    )
  end

  desc "Print configured lanes and required secrets (no Apple upload)"
  lane :doctor do
    UI.header("Interactions TestFlight")
    UI.message("App name:          Interactions")
    UI.message("Bundle ID:         #{APP_IDENTIFIER}")
    UI.message("Project:           #{XCODEPROJ}")
    UI.message("Scheme:            #{SCHEME}")
    UI.message("Marketing version: #{ENV['MARKETING_VERSION'] || '1.0'}")
    UI.message("Build number:      #{ENV['BUILD_NUMBER'] || ENV['GITHUB_RUN_NUMBER'] || '(unset)'}")
    UI.message("Signing:           Automatic + ASC API key + -allowProvisioningUpdates")
    missing = missing_secrets
    if missing.empty?
      UI.success("All required secrets are present in the environment.")
    else
      UI.important("Missing secrets (expected on a dry run): #{missing.join(', ')}")
      UI.important("See docs/TESTFLIGHT.md — do not commit these values.")
    end
  end
end
